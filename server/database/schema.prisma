generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum Animal {
  dog
  cat
  rabbit
  other
}

enum MaritalStatus {
  signle
  relationship
}

enum SubscriptionPlan {
  free
  premium
}

// MODELS
model User {
  uid              String           @id @default(uuid())
  email            String           @unique
  password         String
  verified         Boolean          @default(false)
  subscriptionPlan SubscriptionPlan @default(free)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  data              UserInfo?
  preferences       UserPreference?
  verificationCodes VerificationCode[]
  authSessions      AuthSession[]

  @@map("users")
}

model UserInfo {
  userUid   String   @id
  firstName String
  lastName  String
  avatarUrl String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@map("userInfo")
}

model UserPreference {
  userUid                String   @id
  openToFriendRequests   Boolean  @default(true)
  promotionEmails        Boolean  @default(false)
  newMessageEmails       Boolean  @default(false)
  newFriendRequestEmails Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@map("userPreferences")
}

model VerificationCode {
  id        Int       @id @default(autoincrement())
  userUid   String
  code      String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@unique([userUid, code])
  @@map("verificationCodes")
}

model AuthSession {
  token     String   @default(uuid())
  userUid   String
  revoked   Boolean  @default(false)
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@id([token, userUid])
  @@map("authSessions")
}
